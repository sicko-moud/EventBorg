# Pipeline (local .env; in CI these are GitHub Actions secrets)
CONTACT_EMAIL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODEL=gemini-flash-latest
GEMINI_THINKING=low
LLM_MAX_CALLS=25
LLM_MAX_SECONDS=480
TICKETMASTER_KEY=
# FCM HTTP v1: the service-account JSON (CI secret) or, locally, a path to the gitignored file
FCM_SERVICE_ACCOUNT=firebase-service-account.json
# Social inbox job: the Worker's job endpoints (CI: repo variable WORKER_URL, secret INBOX_TOKEN). GITHUB_TOKEN opens/closes moderation issues.
WORKER_URL=https://eventborg.eventborg-worker.workers.dev
INBOX_TOKEN=
GITHUB_TOKEN=

# Worker secrets (npx wrangler secret put NAME); locally in worker/.dev.vars
# GEMINI_API_KEY, SIGNING_KEY (random 32+ bytes), FCM_SERVICE_ACCOUNT, GH_TOKEN (fine-grained PAT: this repo, Contents read/write),
# INBOX_TOKEN, META_VERIFY_TOKEN (random 32+ bytes each), META_APP_SECRET, META_TOKEN (Page access token),
# WA_TOKEN (WhatsApp system-user token; WhatsApp stays off until WA_TOKEN, WA_PHONE_ID and WA_NUMBER exist), CONTACT_EMAIL (optional)
# Worker vars in wrangler.toml: IG_PUBLIC_INBOX ("false" until Meta App Review), IG_USER_ID, WA_PHONE_ID, WA_NUMBER, GRAPH_VERSION
