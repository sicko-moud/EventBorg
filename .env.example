# Pipeline (local .env; in CI these are GitHub Actions secrets)
CONTACT_EMAIL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODEL=gemini-flash-latest
GEMINI_THINKING=low
LLM_MAX_CALLS=25
LLM_MAX_SECONDS=480
TICKETMASTER_KEY=
# FCM HTTP v1: the Firebase service-account JSON on one line
FCM_SERVICE_ACCOUNT=

# Worker secrets (npx wrangler secret put NAME); locally in worker/.dev.vars
# GEMINI_API_KEY, SIGNING_KEY (random 32+ bytes), GH_TOKEN (fine-grained PAT: this repo, Contents read/write), CONTACT_EMAIL (optional)
